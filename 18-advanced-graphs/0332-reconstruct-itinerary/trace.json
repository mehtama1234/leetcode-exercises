   "for src, dst in tickets:",
   "    heappush(graph[src], dst)   # smallest dst first",
   "stack = ['JFK']; route = []",
   "while stack:",
   "    a = stack[-1]",
   "    if graph[a]:",
   "        stack.append(heappop(graph[a]))",
   "    else:",
   "        route.append(stack.pop())   # stuck: retreat",
   "return route[::-1]"
  ]
