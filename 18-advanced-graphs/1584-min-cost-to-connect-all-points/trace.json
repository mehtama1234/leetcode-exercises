 "code": {
  "dfs": [
   "in_tree = [False]*n; total = 0",
   "heap = [(0, 0)]              # seed point 0 free",
   "while heap and edges < n:",
   "    cost, i = heappop(heap)",
   "    if in_tree[i]: continue",
   "    in_tree[i] = True; total += cost",
   "    for j in range(n):",
   "        if not in_tree[j]:",
   "            heappush(heap, (dist(i, j), j))"
  ]
