   "heap = [(0, k)]",
   "while heap:",
   "    d, node = heappop(heap)",
   "    if node in dist: continue",
   "    dist[node] = d",
   "    for nei, w in graph[node]:",
   "        if nei not in dist:",
   "            heappush(heap, (d + w, nei))",
   "return max(dist.values())"
