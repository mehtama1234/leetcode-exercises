 "title": "Plus One - carry a +1 through the digits, by hand",
 "acts": [
  "The rule",
  "Run: carry stops partway",
  "Edge: all nines"
 ],
 "code": {
  "add": [
   "for i in reversed(range(len(digits))):",
   "    if digits[i] < 9:",
   "        digits[i] += 1",
   "        return digits          # no carry escapes",
   "    digits[i] = 0               # 9 -> 0, carry left",
   "return [1] + digits            # all nines"
  ]
