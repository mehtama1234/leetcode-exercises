{
 "player": "linear",
 "title": "Pow(x, n) - square through the exponent's bits, not n multiplies",
 "acts": [
  "Naive: multiply n times",
  "The waste",
  "Squaring by bits",
  "Edge: negative n"
 ],
 "code": {
  "naive": [
   "result = 1.0",
   "for _ in range(n):",
   "    result *= x",
   "return result"
  ],
  "fast": [
   "result, current = 1.0, x",
   "while n > 0:",
   "    if n & 1:",
   "        result *= current",
   "    current *= current   # x^2, x^4, x^8...",
   "    n >>= 1",
   "return result"
  ]
 },
