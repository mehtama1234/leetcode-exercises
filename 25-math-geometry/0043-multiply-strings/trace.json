 ],
 "code": {
  "mul": [
   "result = [0] * (m + n)",
   "for i in reversed(range(m)):",
   "    for j in reversed(range(n)):",
   "        low = (m-1-i) + (n-1-j)",
   "        result[low] += d1 * d2",
   "for k in range(m+n):        # settle carries",
   "    result[k], carry = (result[k]+carry) % 10, ...",
   "return trimmed big-endian string"
  ]
