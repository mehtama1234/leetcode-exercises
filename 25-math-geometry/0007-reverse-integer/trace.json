 "title": "Reverse Integer - peel digits, push onto result, guard the 32-bit limit",
 "acts": [
  "The rule",
  "Run a clean case",
  "Edge: overflow -> 0"
 ],
 "code": {
  "rev": [
   "sign, x = sign_of(x), abs(x)",
   "result = 0",
   "while x != 0:",
   "    x, digit = divmod(x, 10)   # peel last digit",
   "    if result would exceed limit: return 0",
   "    result = result * 10 + digit",
   "return sign * result"
  ]
 },
