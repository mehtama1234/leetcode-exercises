  "Binary search",
  "Edge case: target absent"
 ],
 "code": {
  "linear": [
   "for i, x in enumerate(nums):",
   "    if x == target:",
   "        return i",
   "return -1"
  ],
  "fast": [
   "lo, hi = 0, len(nums) - 1",
   "while lo <= hi:",
   "    mid = lo + (hi - lo) // 2",
   "    if nums[mid] == target:",
   "        return mid",
   "    if nums[mid] < target:",
   "        lo = mid + 1",
   "    else:",
   "        hi = mid - 1"
  ]
 },
