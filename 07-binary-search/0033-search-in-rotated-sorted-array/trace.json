 ],
 "code": {
  "linear": [
   "for i, x in enumerate(nums):",
   "    if x == target:",
   "        return i",
   "return -1"
  ],
  "fast": [
   "lo, hi = 0, len(nums) - 1",
   "while lo <= hi:",
   "    mid = lo + (hi - lo) // 2",
   "    if nums[mid] == target:",
   "        return mid",
   "    if nums[lo] <= nums[mid]:      # left half sorted",
   "        if nums[lo] <= target < nums[mid]:",
   "            hi = mid - 1",
   "        else:",
   "            lo = mid + 1",
   "    else:                          # right half sorted",
   "        if nums[mid] < target <= nums[hi]:",
   "            lo = mid + 1",
   "        else:",
   "            hi = mid - 1",
   "return -1"
  ]
 },
