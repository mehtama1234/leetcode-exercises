   "for r in range(1,m):",
   "    for c in range(1,n):",
   "        if matrix[r][0]==0 or matrix[0][c]==0: matrix[r][c]=0",
   "if matrix[0][0]==0: blank row 0",
   "if first_col_zero: blank col 0"
  ]
