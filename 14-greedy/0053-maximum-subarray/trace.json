 "code": {
  "brute": [
   "best = nums[0]",
   "for i in range(n):",
   "    running = 0",
   "    for j in range(i, n):",
   "        running += nums[j]",
   "        if running > best:",
   "            best = running"
  ],
  "fast": [
   "cur = nums[0]",
   "best = nums[0]",
   "for x in nums[1:]:",
   "    cur = max(x, cur + x)",
   "    best = max(best, cur)"
  ]
