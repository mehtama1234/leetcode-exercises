 "title": "Maximum Average Subarray I \u2014 from re-summing to a running sum",
 "acts": [
  "Brute force: re-sum each window",
  "The waste",
  "Fast: slide a running sum",
  "Edge case: k = 1"
 ],
 "code": {
  "brute": [
   "for i in range(n - k + 1):",
   "    window_sum = sum(nums[i:i+k])",
   "    best = max(best, window_sum)",
   "return best / k"
  ],
  "fast": [
   "window_sum = sum(nums[:k])",
   "best = window_sum",
   "for i in range(k, n):",
   "    window_sum += nums[i] - nums[i-k]",
   "    best = max(best, window_sum)",
   "return best / k"
  ]
 },
