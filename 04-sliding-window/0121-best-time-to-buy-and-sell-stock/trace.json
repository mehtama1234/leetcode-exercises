 "code": {
  "brute": [
   "for i in range(n):",
   "    for j in range(i+1, n):",
   "        best = max(best, prices[j] - prices[i])",
   "return best"
  ],
  "fast": [
   "min_price = inf",
   "for price in prices:",
   "    if price < min_price: min_price = price",
   "    else: best = max(best, price - min_price)",
   "return best"
  ]
