 "code": {
  "slow": [
   "n = 0",
   "node = head",
   "while node:",
   "    n += 1",
   "    node = node.next",
   "node = head",
   "for _ in range(n // 2):",
   "    node = node.next",
   "return node"
  ],
  "fast": [
   "slow = head",
   "fast = head",
   "while fast and fast.next:",
   "    slow = slow.next",
   "    fast = fast.next.next",
   "return slow"
  ]
 },
