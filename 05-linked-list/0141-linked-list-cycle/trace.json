 ],
 "code": {
  "seen": [
   "seen = set()",
   "node = head",
   "while node:",
   "    if id(node) in seen:",
   "        return True",
   "    seen.add(id(node))",
   "    node = node.next",
   "return False"
  ],
  "fast": [
   "slow = head",
   "fast = head",
   "while fast and fast.next:",
   "    slow = slow.next",
   "    fast = fast.next.next",
   "    if slow is fast:",
   "        return True",
   "return False"
  ]
 },
