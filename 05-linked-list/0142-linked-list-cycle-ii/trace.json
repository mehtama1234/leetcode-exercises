 ],
 "code": {
  "seen": [
   "seen = set(); node = head",
   "while node:",
   "    if id(node) in seen:",
   "        return node",
   "    seen.add(id(node))",
   "    node = node.next",
   "return None"
  ],
  "fast": [
   "slow = fast = head",
   "while fast and fast.next:",
   "    slow = slow.next",
   "    fast = fast.next.next",
   "    if slow is fast:",
   "        ptr = head",
   "        while ptr is not slow:",
   "            ptr = ptr.next; slow = slow.next",
   "        return ptr",
   "return None"
  ]
 },
