 "acts": [
  "Brute: measure then re-walk",
  "The waste",
  "One pass, fixed gap",
  "Edge: remove the head"
 ],
 "code": {
  "slow": [
   "dummy = ListNode(0, head)",
   "length = 0; node = head",
   "while node:",
   "    length += 1; node = node.next",
   "before = dummy",
   "for _ in range(length - n):",
   "    before = before.next",
   "before.next = before.next.next",
   "return dummy.next"
  ],
  "fast": [
   "dummy = ListNode(0, head)",
   "lead = dummy; trail = dummy",
   "for _ in range(n + 1):",
   "    lead = lead.next",
   "while lead:",
   "    lead = lead.next; trail = trail.next",
   "trail.next = trail.next.next",
   "return dummy.next"
  ]
 },
