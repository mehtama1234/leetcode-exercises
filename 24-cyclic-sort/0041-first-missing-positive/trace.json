{
 "player": "linear",
 "title": "First Missing Positive \u2014 the array as its own hash table",
 "acts": [
  "Set baseline (O(n) space)",
  "The idea: value v \u2192 index v-1",
  "Cyclic sort in place",
  "Edge case: fully packed"
 ],
 "code": {
  "set": [
   "present = set(nums)",
   "candidate = 1",
   "while candidate in present:",
   "    candidate += 1",
   "return candidate"
  ],
  "fast": [
   "for i in range(n):",
   "    while 1 <= nums[i] <= n and nums[nums[i]-1] != nums[i]:",
   "        correct = nums[i] - 1",
   "        nums[i], nums[correct] = nums[correct], nums[i]",
   "for i in range(n):",
   "    if nums[i] != i + 1:",
   "        return i + 1",
   "return n + 1"
  ]
 },
