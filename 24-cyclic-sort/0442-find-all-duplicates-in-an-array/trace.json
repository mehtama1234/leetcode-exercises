{
 "player": "linear",
 "title": "Find All Duplicates \u2014 signs catch the second visit",
 "acts": [
  "Seen-set baseline (O(n) space)",
  "The idea: sign = visited",
  "Sign-flip pass in place",
  "Edge case: all unique"
 ],
 "code": {
  "set": [
   "seen = set()",
   "for x in nums:",
   "    if x in seen:",
   "        out.append(x)",
   "    seen.add(x)",
   "return out"
  ],
  "fast": [
   "for x in nums:",
   "    v = abs(x)",
   "    home = v - 1",
   "    if nums[home] < 0:",
   "        out.append(v)",
   "    else:",
   "        nums[home] = -nums[home]"
  ]
 },
