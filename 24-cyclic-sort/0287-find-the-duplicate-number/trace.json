  "brute": [
   "for i in range(n):",
   "    for j in range(i+1, n):",
   "        if nums[i] == nums[j]:",
   "            return nums[i]"
  ],
  "fast": [
   "slow = fast = nums[0]",
   "while True:                 # phase 1: find a meeting point",
   "    slow = nums[slow]",
   "    fast = nums[nums[fast]]",
   "    if slow == fast: break",
   "slow = nums[0]              # phase 2: find the entrance",
   "while slow != fast:",
   "    slow = nums[slow]",
   "    fast = nums[fast]",
   "return slow"
  ]
 },
