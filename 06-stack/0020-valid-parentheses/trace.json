 "title": "Valid Parentheses \u2014 the last opener is the first to close",
 "acts": [
  "The rule: {[]}",
  "Valid: ()[]{}",
  "Edge: interleaved ([)]",
  "Edge: leftover ("
 ],
 "code": {
  "fast": [
   "pairs = {\")\": \"(\", \"]\": \"[\", \"}\": \"{\"}",
   "for ch in s:",
   "    if ch in pairs:            # closer",
   "        if not stack or stack.pop() != pairs[ch]:",
   "            return False",
   "    else:                      # opener",
   "        stack.append(ch)",
   "return not stack"
  ]
