  "brute": [
   "for i in range(n):",
   "    for j in range(i+1, n):",
   "        if temps[j] > temps[i]:",
   "            answer[i] = j - i",
   "            break"
  ],
  "fast": [
   "for i, temp in enumerate(temps):",
   "    while stack and temps[stack[-1]] < temp:",
   "        prev = stack.pop()",
   "        answer[prev] = i - prev",
   "    stack.append(i)"
  ]
