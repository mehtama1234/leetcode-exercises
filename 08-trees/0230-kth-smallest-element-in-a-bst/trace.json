  "kth": [
   "stack, node = [], root",
   "while stack or node:",
   "    while node:            # dive left",
   "        stack.append(node)",
   "        node = node.left",
   "    node = stack.pop()     # smallest unseen",
   "    k -= 1",
   "    if k == 0: return node.val",
   "    node = node.right      # then go right"
  ]
