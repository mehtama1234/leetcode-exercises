 "title": "Serialize / Deserialize - '#' keeps the shape, then rebuild it back",
 "acts": [
  "Why a value list fails",
  "Serialize with '#'",
  "Deserialize: rebuild"
 ],
 "code": {
  "serialize": [
   "def serialize(node):",
   "    if node is None: emit('#'); return",
   "    emit(node.val)",
   "    serialize(node.left)   # preorder: root, left, right",
   "    serialize(node.right)",
   "# --- deserialize ---",
   "def build():",
   "    val = next(tokens)",
   "    if val == '#': return None",
   "    node.left  = build()",
   "    node.right = build()"
  ]
