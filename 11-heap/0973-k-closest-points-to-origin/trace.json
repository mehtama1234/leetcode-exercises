 ],
 "code": {
  "naive": [
   "return sorted(points,",
   "   key=lambda p: p[0]**2 + p[1]**2)[:k]"
  ],
  "fast": [
   "for p in points:",
   "    d2 = p[0]**2 + p[1]**2",
   "    heapq.heappush(heap, (-d2, p))",
   "    if len(heap) > k:",
   "        heapq.heappop(heap)   # drop farthest",
   "return [p for _, p in heap]"
  ]
 },
