{
 "player": "linear",
 "title": "Task Scheduler \u2014 greedy heap simulation, then the formula",
 "acts": [
  "The greedy rule",
  "Simulate with a max-heap",
  "The O(1) formula",
  "Edge: n = 0"
 ],
 "code": {
  "sim": [
   "while heap or wait:",
   "    time += 1",
   "    if heap:",
   "        remaining = heappop(heap) + 1   # run one",
   "        if remaining < 0:",
   "            wait.append((time+n, remaining))",
   "    if wait and wait[0][0] == time:",
   "        heappush(heap, wait.popleft()[1])"
  ],
  "formula": [
   "f_max = max(counts.values())",
   "ties = #(counts == f_max)",
   "frame = (f_max - 1) * (n + 1) + ties",
   "return max(len(tasks), frame)"
  ]
 },
