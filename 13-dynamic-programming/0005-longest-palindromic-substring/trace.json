 "code": {
  "dp": [
   "dp = [[False]*n for _ in range(n)]",
   "for i in range(n-1, -1, -1):",
   "    for j in range(i, n):",
   "        if s[i]==s[j] and (j-i < 2 or dp[i+1][j-1]):",
   "            dp[i][j] = True",
   "            if j-i+1 > best: start, best = i, j-i+1",
   "return s[start:start+best]"
  ]
