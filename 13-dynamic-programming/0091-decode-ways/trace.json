 ],
 "code": {
  "dp": [
   "dp[n] = 1",
   "for i in range(n-1, -1, -1):",
   "    if s[i] == '0': dp[i] = 0",
   "    else:",
   "        dp[i] = dp[i+1]                 # single digit",
   "        if s[i:i+2] <= 26: dp[i]+=dp[i+2]  # pair",
   "return dp[0]"
  ]
 },
