  "The rule: n clubs",
  "Run Union-Find",
  "Edge: redundant edge"
 ],
 "code": {
  "uf": [
   "parent = list(range(n)); count = n   # n lonely clubs",
   "def find(x):                          # x's club root",
   "    while parent[x] != x: x = parent[x]",
   "    return x",
   "for a, b in edges:",
   "    ra, rb = find(a), find(b)",
   "    if ra == rb: continue             # same club: redundant",
   "    parent[rb] = ra                   # fuse two clubs",
   "    count -= 1",
   "return count"
  ]
 },
