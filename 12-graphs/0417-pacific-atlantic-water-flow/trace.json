 "code": {
  "flood": [
   "def flood(starts):        # walk UPHILL from an ocean edge",
   "    reach = set()",
   "    stack = list(starts)",
   "    while stack:",
   "        r, c = stack.pop()",
   "        reach.add((r, c))",
   "        for nr, nc in neighbors(r, c):",
   "            if heights[nr][nc] >= heights[r][c]:",
   "                stack.append((nr, nc))   # uphill in reverse",
   "    return reach",
   "return pacific & atlantic"
  ]
 },
