  "brute": [
   "for i in range(n):",
   "    walk left while >= h[i]",
   "    walk right while >= h[i]",
   "    best = max(best, h[i] * width)"
  ],
  "fast": [
   "for i, h in enumerate(heights + [0]):",
   "    while stack and heights[stack[-1]] > h:",
   "        top = stack.pop()",
   "        left = stack[-1] if stack else -1",
   "        width = i - left - 1",
   "        best = max(best, heights[top] * width)",
   "    stack.append(i)"
  ]
