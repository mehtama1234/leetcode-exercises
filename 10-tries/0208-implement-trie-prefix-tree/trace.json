  "insert": [
   "def insert(word):",
   "    node = root",
   "    for ch in word:",
   "        node = node.children.setdefault(ch, TrieNode())",
   "    node.is_word = True",
   "",
   "def _walk(prefix):        # -> node or None",
   "    node = root",
   "    for ch in prefix:",
   "        if ch not in node.children: return None",
   "        node = node.children[ch]",
   "    return node"
  ],
