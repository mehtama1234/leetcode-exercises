{
 "player": "tree",
 "title": "WordDictionary - a trie whose search fans out on '.'",
 "acts": [
  "The rule",
  "Exact walk: 'bad'",
  "Wildcard: '.ad'",
  "Edge: '.' needs a real node"
 ],
 "code": {
  "dfs": [
   "def search(word):",
   "    def dfs(i, node):",
   "        if i == len(word):",
   "            return node.is_word",
   "        ch = word[i]",
   "        if ch == '.':",
   "            return any(dfs(i+1, c) for c in node.children.values())",
   "        if ch not in node.children: return False",
   "        return dfs(i+1, node.children[ch])",
   "    return dfs(0, root)"
  ]
 },
