 ],
 "code": {
  "main": [
   "def backtrack(start, remaining):",
   "    if remaining == 0:",
   "        result.append(path.copy())",
   "        return",
   "    for i in range(start, len(candidates)):",
   "        c = candidates[i]",
   "        if c > remaining:",
   "            break",
   "        path.append(c)",
   "        backtrack(i, remaining - c)",
   "        path.pop()"
  ]
 },
