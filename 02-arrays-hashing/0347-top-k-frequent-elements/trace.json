 "title": "Top K Frequent \u2014 the frequency is the index, so no sort",
 "acts": [
  "Baseline: count + sort",
  "The insight",
  "Fast: bucket by frequency",
  "Edge case: k = distinct count"
 ],
 "code": {
  "sort": [
   "counts = Counter(nums)",
   "ordered = sorted(counts, key=counts.get, reverse=True)",
   "return ordered[:k]"
  ],
  "fast": [
   "counts = Counter(nums)",
   "buckets = [[] for _ in range(n+1)]",
   "for value, freq in counts.items():",
   "    buckets[freq].append(value)",
   "for freq in range(n, 0, -1):",
   "    for value in buckets[freq]:",
   "        result.append(value)",
   "        if len(result) == k: return result"
  ]
