{
 "player": "linear",
 "title": "Valid Anagram \u2014 count the letters, don't sort them",
 "acts": [
  "Baseline: sort both",
  "The insight",
  "Fast: count map",
  "Edge case: 'rat' vs 'car'"
 ],
 "code": {
  "sort": [
   "return sorted(s) == sorted(t)"
  ],
  "fast": [
   "if len(s) != len(t): return False",
   "counts = {}",
   "for ch in s: counts[ch] += 1",
   "for ch in t:",
   "    counts[ch] -= 1",
   "    if counts[ch] < 0: return False",
   "return all(v == 0 for v in counts.values())"
  ]
 },
