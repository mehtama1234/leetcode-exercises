 ],
 "code": {
  "brute": [
   "for i in range(n):",
   "    for j in range(i+1, n):",
   "        if nums[i] + nums[j] == target:",
   "            return [i, j]"
  ],
  "fast": [
   "seen = {}",
   "for i, x in enumerate(nums):",
   "    need = target - x",
   "    if need in seen:",
   "        return [seen[need], i]",
   "    seen[x] = i"
  ]
 },
