   "def backtrack(start):",
   "    result.append(path[:])          # every node is a subset",
   "    for i in range(start, n):",
   "        if i > start and nums[i] == nums[i-1]:",
   "            continue                # skip duplicate sibling",
   "        path.append(nums[i])        # choose",
   "        backtrack(i + 1)            # explore the tail",
   "        path.pop()                  # un-choose"
