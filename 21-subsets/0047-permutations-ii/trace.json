  "backtrack": [
   "def backtrack():",
   "    if len(path) == n:",
   "        result.append(path[:])",
   "        return",
   "    for i in range(n):",
   "        if used[i]:",
   "            continue",
   "        if i>0 and nums[i]==nums[i-1] and not used[i-1]:",
   "            continue          # skip duplicate sibling",
   "        used[i] = True        # choose",
   "        path.append(nums[i])",
   "        backtrack()           # explore",
   "        path.pop()            # un-choose",
   "        used[i] = False"
  ]
