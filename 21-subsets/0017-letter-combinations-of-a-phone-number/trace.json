   "def backtrack(i):",
   "    if i == len(digits):",
   "        result.append(''.join(path))",
   "        return",
   "    for letter in KEYPAD[digits[i]]:",
   "        path.append(letter)  # choose",
   "        backtrack(i + 1)     # explore",
   "        path.pop()           # un-choose"
  ]
