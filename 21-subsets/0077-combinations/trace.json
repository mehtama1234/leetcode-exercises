   "def backtrack(start):",
   "    if len(path) == k:",
   "        result.append(path[:])",
   "        return",
   "    need = k - len(path)",
   "    last_ok = n - need + 1",
   "    for i in range(start, last_ok + 1):",
   "        path.append(i)      # choose",
   "        backtrack(i + 1)    # explore",
   "        path.pop()          # un-choose"
  ]
