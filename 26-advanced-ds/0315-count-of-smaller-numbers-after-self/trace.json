 "code": {
  "brute": [
   "for i in range(n):",
   "    for j in range(i+1, n):",
   "        if nums[j] < nums[i]:",
   "            result[i] += 1"
  ],
  "bit": [
   "ranks: sorted distinct values -> 1..m",
   "for i from RIGHT to LEFT:",
   "    r = rank(nums[i])",
   "    result[i] = prefix(r - 1)   # smaller, already inserted",
   "    add(r)                       # record nums[i] as 'seen to the right'"
  ]
