 "code": {
  "uf": [
   "uf = UnionFind(n)          # count = n singleton groups",
   "for i in range(n):",
   "    for j in range(i+1, n):",
   "        if isConnected[i][j]:",
   "            uf.union(i, j)  # merge -> count -= 1 if new",
   "return uf.count"
  ]
