 ],
 "code": {
  "brute": [
   "for i in range(n):",
   "    for j in range(i+1, n):",
   "        area = (j-i) * min(h[i], h[j])",
   "        best = max(best, area)"
  ],
  "fast": [
   "left, right = 0, n-1",
   "while left < right:",
   "    area = (right-left) * min(h[left], h[right])",
   "    best = max(best, area)",
   "    if h[left] < h[right]: left += 1",
   "    else: right -= 1"
  ]
 },
