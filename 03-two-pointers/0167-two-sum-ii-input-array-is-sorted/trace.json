   "    for j in range(i+1, n):",
   "        if numbers[i] + numbers[j] == target:",
   "            return [i+1, j+1]"
  ],
  "fast": [
   "left, right = 0, n-1",
   "while left < right:",
   "    s = numbers[left] + numbers[right]",
   "    if s == target: return [left+1, right+1]",
   "    if s < target: left += 1",
   "    else: right -= 1"
  ]
