{
 "player": "linear",
 "title": "Counting Bits - reuse the answer for i with its lowest bit dropped",
 "acts": [
  "Brute: count each from scratch",
  "The waste",
  "DP: ans[i] = ans[i&(i-1)]+1",
  "Edge: i = 0"
 ],
 "code": {
  "brute": [
   "for i in range(n + 1):",
   "    count = 0; x = i",
   "    while x:",
   "        x &= x - 1   # drop lowest set bit",
   "        count += 1",
   "    ans.append(count)"
  ],
  "dp": [
   "ans = [0] * (n + 1)",
   "for i in range(1, n + 1):",
   "    ans[i] = ans[i & (i - 1)] + 1",
   "return ans"
  ]
 },
