 "title": "Number of 1 Bits - from scan-every-position to clear-one-bit-per-step",
 "acts": [
  "Brute: scan every position",
  "The waste",
  "Kernighan: clear a bit each step",
  "Edge: all bits set"
 ],
 "code": {
  "scan": [
   "count = 0",
   "while n:",
   "    count += n & 1",
   "    n >>= 1",
   "return count"
  ],
  "kern": [
   "count = 0",
   "while n:",
   "    n &= n - 1   # clear lowest set bit",
   "    count += 1",
   "return count"
  ]
 },
