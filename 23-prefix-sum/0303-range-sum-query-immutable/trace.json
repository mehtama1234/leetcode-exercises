 "code": {
  "brute": [
   "def sumRange(left, right):",
   "    return sum(nums[left : right+1])"
  ],
  "build": [
   "prefix = [0] * (n + 1)",
   "for i, x in enumerate(nums):",
   "    prefix[i+1] = prefix[i] + x"
  ],
  "fast": [
   "def sumRange(left, right):",
   "    return prefix[right+1] - prefix[left]"
  ]
