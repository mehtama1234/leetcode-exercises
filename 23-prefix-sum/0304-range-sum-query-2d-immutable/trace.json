 ],
 "code": {
  "brute": [
   "def sumRegion(r1, c1, r2, c2):",
   "    total = 0",
   "    for r in range(r1, r2+1):",
   "        for c in range(c1, c2+1):",
   "            total += matrix[r][c]",
   "    return total"
  ],
  "build": [
   "P = (rows+1) x (cols+1) of 0",
   "P[r+1][c+1] = matrix[r][c]",
   "           + P[r][c+1] + P[r+1][c]",
   "           - P[r][c]"
  ],
  "fast": [
   "def sumRegion(r1, c1, r2, c2):",
   "    return (P[r2+1][c2+1]",
   "          - P[r1][c2+1]",
   "          - P[r2+1][c1]",
   "          + P[r1][c1])"
  ]
 },
